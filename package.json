{
  "name": "@windowkit/win32",
  "version": "0.0.1",
  "description": "Mechanism-only Win32 bridge for Node.js: HWNDs on a UI thread of their own, DirectComposition surfaces, a Direct2D verb table and DirectWrite text — the Windows half of react-x11.",
  "main": "index.js",
  "os": ["win32"],
  "cpu": ["x64", "arm64"],
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "index.js",
    "binding.gyp",
    "src/",
    "scripts/",
    "prebuilds/",
    "README.md"
  ],
  "scripts": {
    "install": "node scripts/install.js",
    "build": "node-gyp rebuild",
    "build:prebuild": "node scripts/prebuild.js",
    "test": "node test/smoke.js && node test/text.js",
    "demo": "node examples/window.js"
  },
  "dependencies": {
    "node-addon-api": "^8.3.0"
  },
  "gypfile": true,
  "license": "MIT",
  "author": "Andrey Sidorov <andrey.sidorov@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/windowkit/win32.git"
  },
  "bugs": {
    "url": "https://github.com/windowkit/win32/issues"
  },
  "homepage": "https://github.com/windowkit/win32#readme",
  "keywords": [
    "win32",
    "direct2d",
    "directwrite",
    "directcomposition",
    "windows",
    "react-x11"
  ]
}
